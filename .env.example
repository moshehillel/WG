# ProviderSoft
PROVIDERSOFT_BASE_URL=https://web2.providersoftllc.com/WhiteGloveCommunityCareInc
PROVIDERSOFT_USERNAME=
PROVIDERSOFT_PASSWORD=
# Saved report IDs (ReportView.aspx?UserReportId=…). From codegen/Network.
PROVIDERSOFT_REPORT_OPENED_ID=4526
PROVIDERSOFT_REPORT_CLOSED_ID=4527
PROVIDERSOFT_REPORT_DISCHARGE_ID=4528
PROVIDERSOFT_REPORT_SESSIONS_ID=4026
# Capture UserReportId from PS Network when exporting "caregiver codes"
PROVIDERSOFT_REPORT_CAREGIVER_CODES_ID=4541
# Saved report: existing child + new service line (filter Service Begin Date in PS)
PROVIDERSOFT_REPORT_NEW_SERVICES_ID=4544
# AWS: leave stubs on until go-live. Live bot image: cdk -c providerSoftLiveBot=true
# PROVIDERSOFT_USE_STUBS=true
# PROVIDERSOFT_REPORT_KINDS=opened_cases,closed_cases,discharge_service,verified_sessions

# HHA SOAP — SANDBOX ONLY until go-live is approved
# Do not use https://app.hhaexchange.com here yet.
HHA_BASE_URL=https://sandbox1.hhaexchange.com/Integration/ENT/V1.8/ws.asmx
HHA_APP_NAME=
HHA_APP_SECRET=
HHA_APP_KEY=
HHA_OFFICE_ID=1025
HHA_COORDINATOR_ID=81103
# Optional CreatePatient defaults (sandbox patient 958000 setup)
# HHA_SOURCE_OF_ADMISSION=9300
# HHA_BRANCH_ID=10073742
# HHA_TEAM_ID=2036
# HHA_LOCATION_ID=12284
# HHA_MOBILITY_STATUS_ID=2495
# HHA_EVACUATION_ZONE_ID=10003239
# HHA_DEFAULT_GENDER=Male
# HHA_ADMISSION_ID_PREFIX=PS
HHA_API_KEY=
HHA_USE_MOCK=true
# Set to true only after explicit go-live approval
HHA_ALLOW_PRODUCTION=false
# Closure default: Discharged To = Home → HHA "self/family/friend" (GetPatientDischargeTo)
HHA_DISCHARGE_TO_ID=198
# Sandbox cannot read confirm reason codes (-9); read from prod (read-only) for sandbox testing
HHA_ALLOW_REASON_LOOKUP=true
HHA_REASON_LOOKUP_URL=https://app.hhaexchange.com/Integration/ENT/V1.8/ws.asmx
HHA_REASON_LOOKUP_VISIT_ID=1308496385

# Luna support chatbot (TMS API / Lambda only — never put in apps/tms-web or Netlify)
# Local: set OPENAI_API_KEY before `npm run tms:local`
# Live: AWS Secrets Manager → TmsLunaOpenAiSecret (see CDK output TmsLunaOpenAiSecretArn)
#   Paste plain sk-... key (not JSON). Optional seed: cdk deploy -c openaiApiKey=sk-...
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LUNA_SUPPORT_EMAIL=moshe@advancedautomations.net

# Timesheet principal e-sign: **SignNow** (not DocuSign).
# Live: AWS Secrets Manager → TmsDocuSignSecret (CDK output TmsDocuSignSecretArn), us-east-1.
#   Replace secret JSON (do not commit keys):
#   {
#     "vendor": "signnow",
#     "api_key": "paste-from-signnow-api-dashboard",
#     "from_email": "signnow-account-login@example.com",
#     "webhook_url": "https://YOUR-TMS-API-URL/webhooks/esign"
#   }
# OAuth alternative (instead of api_key): basic_token OR client_id+client_secret, plus username+password.
# Local override (optional): TMS_SIGNNOW_API_KEY=  TMS_SIGNNOW_FROM_EMAIL=
# TMS_SIGNNOW_SECRET_ARN=   (defaults to TMS_DOCUSIGN_SECRET_ARN on Lambda)
# TMS_ESIGN_WEBHOOK_URL=http://localhost:8787/webhooks/esign
# TMS_SIGNNOW_ALLOW_EMAIL_FALLBACK=1  # dev only — SES PDF instead of SignNow

# Local / pipeline
REPORTS_BUCKET=
# TMS DynamoDB table (Lambda sets automatically). Empty = local memory / legacy S3 snapshot.
TMS_STATE_TABLE=
IDEMPOTENCY_TABLE=
AWS_REGION=us-east-1
LOCAL_DOWNLOAD_DIR=./downloads
HEADLESS=true
DRY_RUN=false
# SNS topic for pipeline exceptions (set by CDK in AWS; optional locally)
# EXCEPTION_TOPIC_ARN=

