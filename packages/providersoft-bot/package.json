{
  "name": "@white-glove/providersoft-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "local:download": "tsx src/local-cli.ts",
    "download:http": "tsx scripts/download-http.ts",
    "login:probe": "tsx src/login-probe.ts",
    "train:bot": "tsx src/train-bot.ts",
    "train:rebuild-gender": "tsx scripts/repair-gluck-gender-reports.ts",
    "capture:reports": "tsx src/capture-report-network.ts",
    "codegen:ps": "playwright codegen"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/client-secrets-manager": "^3.716.0",
    "@white-glove/shared": "*",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
