{
  "name": "@white-glove/tms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/handler.js",
  "types": "./dist/handler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "local": "tsx src/local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.716.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.716.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/client-ses": "^3.716.0",
    "@white-glove/hha-client": "*",
    "@white-glove/shared": "*",
    "@white-glove/tms-db": "*",
    "aws-jwt-verify": "^4.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
